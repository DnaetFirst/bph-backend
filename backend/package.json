{
  "name": "bph-backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev:node": "node src-node/server.js",
    "start:node": "node src-node/server.js",
    "build:node": "prisma generate --schema prisma/schema.node.prisma",
    "prisma:generate:node": "prisma generate --schema prisma/schema.node.prisma",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:deploy:node": "prisma migrate deploy --schema prisma/schema.node.prisma",
    "seed": "node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pg": "^8.22.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
