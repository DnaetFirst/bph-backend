# Copiá este archivo a ".env" (sin ".example"). Este .env es SOLO para el
# CLI de Prisma (migrate, generate, seed) corriendo en tu máquina — no lo usa
# el Worker en producción, que se conecta vía el binding de Hyperdrive.
# NUNCA commitees el ".env" real — ya está en .gitignore.

# Conexión DIRECTA a Supabase (puerto 5432, sin pooler) — la misma que
# usaste para crear el Hyperdrive con `wrangler hyperdrive create`.
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres"

# PIN inicial del usuario administrador que crea el seed (cambialo)
SEED_ADMIN_PIN="000000"

# Credenciales de Gmail para recuperación de PIN (app password, no tu contraseña personal)
# 1. Ve a tu cuenta de Google → Seguridad → Verificación en dos pasos → Activar
# 2. Busca "Contraseñas de aplicaciones" → Generar contraseña de aplicación
# 3. Selecciona "Otro (personalizado)" → Nombre: "BPH Backend"
# 4. Copia la contraseña de 16 dígitos (formato: xxxx xxxx xxxx xxxx) y pégala abajo
EMAIL_USER="tu_correo@gmail.com"
EMAIL_PASS="xxxx xxxx xxxx xxxx"

# URL del frontend (coma-separada para múltiples entornos)
FRONTEND_URL="http://localhost:5173,https://frontend-auto.bph-backend-esqueleto.workers.dev"

# JWT
JWT_SECRET="cambia-esto-por-un-secreto-aleatorio-de-al-menos-32-caracteres"

# Configuración opcional de login
JWT_EXPIRATION_SECONDS=28800
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_SEGUNDOS=30
